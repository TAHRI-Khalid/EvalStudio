<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tk.tahri.eval.desktop.ui.controllers.StudentsViewController"
      spacing="14" VBox.vgrow="ALWAYS" style="-fx-padding: 14 0 0 0;">

    <!-- En-tête de vue -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox HBox.hgrow="ALWAYS" spacing="2">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Étudiants &amp; Inscriptions" styleClass="page-title"/>
                <Label fx:id="lblHeaderStudentCount" text="0 étudiant(s)" styleClass="tag-badge"
                       style="-fx-font-size: 11px; -fx-font-weight: 600;"/>
            </HBox>
            <Label text="Gérez les listes d'étudiants inscrits, importez vos listes Excel et gérez les matricules • Double-cliquez pour modifier" styleClass="page-subtitle"/>
        </VBox>
        <TextField fx:id="searchField" promptText="Filtrer les étudiants..." prefWidth="240" styleClass="search-field"/>
        <Button fx:id="btnNewStudent" text="Nouvel étudiant" styleClass="btn-primary" onAction="#onNewStudent"/>
    </HBox>

    <!-- Notification inline pour messages d'état (import Excel, succès, etc.) -->
    <HBox fx:id="inlineNotificationBox" alignment="CENTER_LEFT" spacing="10" visible="false" managed="false"
          style="-fx-background-color: #e6f7ec; -fx-background-radius: 8px; -fx-padding: 8 16;">
        <FontIcon fx:id="inlineNotificationIcon" iconLiteral="fth-check-circle" iconSize="16" iconColor="#1b8744"/>
        <Label fx:id="lblInlineNotification" text="" style="-fx-text-fill: #00210e; -fx-font-weight: 600; -fx-font-size: 12px;"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button text="×" onAction="#hideInlineNotification" style="-fx-background-color: transparent; -fx-font-size: 14px; -fx-cursor: hand; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Barre d'actions et informations de la liste (juste au-dessus du tableau) -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="lblStudentCount" text="0 étudiant(s) inscrit(s)" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #424753;"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnImportExcel" text="Importer Excel" styleClass="card-action-btn" onAction="#onImportExcel"/>
        <Button fx:id="btnExportExcel" text="Exporter Excel" styleClass="card-action-btn" onAction="#onExportExcel"/>
    </HBox>

    <!-- Tableau des Étudiants prenant tout l'espace disponible -->
    <TableView fx:id="studentsTable" VBox.vgrow="ALWAYS" maxHeight="Infinity" maxWidth="Infinity" minHeight="200" styleClass="table-view">
        <columns>
            <TableColumn fx:id="colMatricule" text="Matricule / Code" prefWidth="160" minWidth="120" maxWidth="200"/>
            <TableColumn fx:id="colLastName" text="Nom" prefWidth="200" minWidth="140"/>
            <TableColumn fx:id="colFirstName" text="Prénom" prefWidth="200" minWidth="140"/>
            <TableColumn fx:id="colFullName" text="Nom complet" prefWidth="250" minWidth="160"/>
            <TableColumn fx:id="colRole" text="Statut" prefWidth="120" minWidth="100" maxWidth="150"/>
            <TableColumn fx:id="colActions" text="Actions" prefWidth="70" minWidth="60" maxWidth="90" style="-fx-alignment: CENTER;"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <placeholder>
            <VBox alignment="CENTER" spacing="12" styleClass="empty-state-box">
                <HBox alignment="CENTER" styleClass="empty-state-icon-container">
                    <FontIcon iconLiteral="fth-user-plus" iconColor="#004faa" iconSize="32"/>
                </HBox>
                <Label text="Aucun étudiant inscrit" styleClass="empty-state-title"/>
                <Label text="Ajoutez votre premier étudiant ou importez une liste Excel (.xlsx)" styleClass="empty-state-subtitle"/>
                <HBox alignment="CENTER" spacing="10">
                    <Button text="Importer Excel" styleClass="card-action-btn" onAction="#onImportExcel"/>
                    <Button text="Nouvel étudiant" styleClass="btn-primary" onAction="#onNewStudent"/>
                </HBox>
            </VBox>
        </placeholder>
    </TableView>
</VBox>
