<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tk.tahri.eval.desktop.ui.controllers.SettingsViewController"
      spacing="16" VBox.vgrow="ALWAYS" style="-fx-padding: 24 32 32 32;">

    <!-- En-tête -->
    <VBox spacing="2" styleClass="view-header">
        <Label text="Paramètres &amp; Environnement" styleClass="view-title"/>
        <Label text="État des moteurs d'analyse et de la base de données locale" style="-fx-text-fill: -color-fg-muted;"/>
    </VBox>

    <GridPane hgap="16" vgap="16">
        <!-- Carte Base de données H2 -->
        <VBox spacing="10" styleClass="card" GridPane.rowIndex="0" GridPane.columnIndex="0" prefWidth="480">
            <Label text="Base de données locale H2" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <GridPane hgap="10" vgap="6">
                <Label text="Fichier :" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="lblDbPath" wrapText="true" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Taille :" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label fx:id="lblDbSize" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Mode :" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Label text="Fichier autonome (Mono-utilisateur)" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>
        </VBox>

        <!-- Carte Vision OpenCV & ONNX -->
        <VBox spacing="10" styleClass="card" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="480">
            <Label text="Moteurs de Reconnaissance Optique" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <GridPane hgap="10" vgap="6">
                <Label text="OpenCV :" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="lblOpenCvStatus" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Modèle ONNX :" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label fx:id="lblOnnxStatus" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            </GridPane>
        </VBox>
    </GridPane>
</VBox>
