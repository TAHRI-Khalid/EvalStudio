<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tk.tahri.eval.desktop.ui.controllers.StudentsViewController"
      spacing="14" VBox.vgrow="ALWAYS" style="-fx-padding: 14 0 0 0;">

    <!-- En-tête de vue -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox HBox.hgrow="ALWAYS" spacing="2">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Étudiants &amp; Inscriptions" styleClass="page-title"/>
                <Label fx:id="lblHeaderStudentCount" text="0 étudiant(s)" styleClass="tag-badge"
                       style="-fx-font-size: 11px; -fx-font-weight: 600;"/>
            </HBox>
            <Label text="Gérez les listes d'étudiants inscrits, importez vos listes Excel et gérez les matricules • Double-cliquez pour modifier" styleClass="page-subtitle"/>
        </VBox>
        <TextField fx:id="searchField" promptText="Filtrer les étudiants..." prefWidth="240" styleClass="search-field"/>
        <Button fx:id="btnImportExcel" text="Importer Excel (.xlsx)" styleClass="card-action-btn" onAction="#onImportExcel"/>
        <Button fx:id="btnNewStudent" text="Nouvel étudiant" styleClass="btn-primary" onAction="#onNewStudent"/>
    </HBox>

    <!-- Formulaire INLINE (aucune fenêtre modale) pour création / modification d'étudiant -->
    <VBox fx:id="studentFormCard" spacing="12" visible="false" managed="false"
          style="-fx-background-color: #f7f9ff; -fx-border-color: #c2c6d5; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-padding: 18;">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <FontIcon fx:id="formIcon" iconLiteral="fth-user-plus" iconSize="16" iconColor="#004faa"/>
            <Label fx:id="lblFormTitle" text="Ajouter un étudiant" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #181c20;"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnCloseForm" styleClass="card-action-btn" onAction="#onCancelForm"/>
        </HBox>
        <GridPane hgap="16" vgap="10">
            <VBox spacing="4" GridPane.columnIndex="0" HBox.hgrow="ALWAYS">
                <Label text="Matricule / Code étudiant *" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #181c20;"/>
                <TextField fx:id="txtMatricule" promptText="Ex: 2024001"/>
            </VBox>
            <VBox spacing="4" GridPane.columnIndex="1" HBox.hgrow="ALWAYS">
                <Label text="Nom de famille *" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #181c20;"/>
                <TextField fx:id="txtLastName" promptText="Ex: Dupont"/>
            </VBox>
            <VBox spacing="4" GridPane.columnIndex="2" HBox.hgrow="ALWAYS">
                <Label text="Prénom" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #181c20;"/>
                <TextField fx:id="txtFirstName" promptText="Ex: Jean"/>
            </VBox>
        </GridPane>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label fx:id="lblFormError" text="" visible="false" style="-fx-text-fill: #ba1a1a; -fx-font-size: 12px; -fx-font-weight: 600;"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnCancelForm" text="Annuler" onAction="#onCancelForm"/>
            <Button fx:id="btnSaveStudent" text="Enregistrer l'étudiant" styleClass="btn-primary" onAction="#onSaveStudent"/>
        </HBox>
    </VBox>

    <!-- Barre de confirmation de suppression INLINE (sans fenêtre modale) -->
    <HBox fx:id="deleteConfirmBox" alignment="CENTER_LEFT" spacing="12" visible="false" managed="false"
          style="-fx-background-color: #ffdad6; -fx-background-radius: 8px; -fx-padding: 10 16;">
        <FontIcon iconLiteral="fth-alert-triangle" iconSize="16" iconColor="#ba1a1a"/>
        <Label fx:id="lblConfirmDelete" text="Êtes-vous sûr de vouloir retirer cet étudiant du groupe ?"
               style="-fx-text-fill: #410002; -fx-font-weight: 600; -fx-font-size: 13px;"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button text="Annuler" onAction="#onCancelDelete"/>
        <Button fx:id="btnConfirmDelete" text="Oui, retirer"
                style="-fx-background-color: #ba1a1a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 6 14;"
                onAction="#onConfirmDelete"/>
    </HBox>

    <!-- Notification inline pour messages d'état (import Excel, succès, etc.) -->
    <HBox fx:id="inlineNotificationBox" alignment="CENTER_LEFT" spacing="10" visible="false" managed="false"
          style="-fx-background-color: #e6f7ec; -fx-background-radius: 8px; -fx-padding: 8 16;">
        <FontIcon fx:id="inlineNotificationIcon" iconLiteral="fth-check-circle" iconSize="16" iconColor="#1b8744"/>
        <Label fx:id="lblInlineNotification" text="" style="-fx-text-fill: #00210e; -fx-font-weight: 600; -fx-font-size: 12px;"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button text="×" onAction="#hideInlineNotification" style="-fx-background-color: transparent; -fx-font-size: 14px; -fx-cursor: hand; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Barre d'informations et export -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="lblStudentCount" text="0 étudiant(s) inscrit(s)" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #424753;"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnExportExcel" text="Exporter la liste (.xlsx)" onAction="#onExportExcel"/>
    </HBox>

    <!-- Tableau des Étudiants prenant tout l'espace disponible -->
    <TableView fx:id="studentsTable" VBox.vgrow="ALWAYS" maxHeight="Infinity" maxWidth="Infinity" minHeight="200" styleClass="table-view">
        <columns>
            <TableColumn fx:id="colMatricule" text="Matricule / Code" prefWidth="160" minWidth="120" maxWidth="200"/>
            <TableColumn fx:id="colLastName" text="Nom" prefWidth="200" minWidth="140"/>
            <TableColumn fx:id="colFirstName" text="Prénom" prefWidth="200" minWidth="140"/>
            <TableColumn fx:id="colFullName" text="Nom complet" prefWidth="250" minWidth="160"/>
            <TableColumn fx:id="colRole" text="Statut" prefWidth="120" minWidth="100" maxWidth="150"/>
            <TableColumn fx:id="colActions" text="Actions" prefWidth="120" minWidth="110" maxWidth="140" style="-fx-alignment: CENTER;"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <placeholder>
            <VBox alignment="CENTER" spacing="12" styleClass="empty-state-box">
                <HBox alignment="CENTER" styleClass="empty-state-icon-container">
                    <FontIcon iconLiteral="fth-user-plus" iconColor="#004faa" iconSize="32"/>
                </HBox>
                <Label text="Aucun étudiant inscrit" styleClass="empty-state-title"/>
                <Label text="Ajoutez votre premier étudiant ou importez une liste Excel (.xlsx)" styleClass="empty-state-subtitle"/>
                <HBox alignment="CENTER" spacing="10">
                    <Button text="Importer Excel" styleClass="card-action-btn" onAction="#onImportExcel"/>
                    <Button text="Nouvel étudiant" styleClass="btn-primary" onAction="#onNewStudent"/>
                </HBox>
            </VBox>
        </placeholder>
    </TableView>
</VBox>
