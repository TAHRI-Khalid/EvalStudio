<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tk.tahri.eval.desktop.ui.controllers.CorrectionViewController"
      spacing="12" VBox.vgrow="ALWAYS" style="-fx-padding: 12 0 0 0;">

    <!-- 1. Vue Liste des Évaluations prêtes pour impression/correction -->
    <VBox fx:id="evalSelectionView" spacing="14" VBox.vgrow="ALWAYS" maxHeight="Infinity">
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="view-header">
            <VBox HBox.hgrow="ALWAYS" spacing="2">
                <Label text="Correction &amp; Scanner OMR" styleClass="page-title"/>
                <Label text="Épreuves prêtes pour impression • Cliquez sur une épreuve pour afficher son tableau de bord" styleClass="page-subtitle"/>
            </VBox>
            <Button fx:id="btnOpenPdfFromList" text="Voir le PDF généré" disable="true" onAction="#onOpenPdfFromList"/>
            <Label fx:id="lblEvalCount" text="0 épreuve(s) prête(s)" style="-fx-font-size: 12px; -fx-text-fill: #424753; -fx-font-weight: 600;"/>
        </HBox>

        <TableView fx:id="evaluationsTable" VBox.vgrow="ALWAYS" maxHeight="Infinity" maxWidth="Infinity" minHeight="200" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colEvalDesignation" text="Intitulé de l'épreuve" prefWidth="280" minWidth="180"/>
                <TableColumn fx:id="colEvalType" text="Type d'évaluation" prefWidth="180" minWidth="140"/>
                <TableColumn fx:id="colEvalDate" text="Date de création" prefWidth="130" minWidth="110" maxWidth="150"/>
                <TableColumn fx:id="colEvalQuestions" text="Questions" prefWidth="110" minWidth="90" maxWidth="130"/>
                <TableColumn fx:id="colEvalState" text="Statut" prefWidth="180" minWidth="150" maxWidth="220"/>
                <TableColumn fx:id="colEvalAction" text="Action" prefWidth="150" minWidth="130" maxWidth="180" style="-fx-alignment: CENTER;"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <placeholder>
                <VBox alignment="CENTER" spacing="10">
                    <FontIcon iconLiteral="fth-inbox" iconColor="#74777f" iconSize="36"/>
                    <Label text="Aucune épreuve prête pour impression ou correction" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #424753;"/>
                    <Label text="Générez d'abord les copies PDF d'une évaluation dans l'onglet « Évaluations » pour qu'elle apparaisse ici." style="-fx-text-fill: #74777f; -fx-font-size: 12px;"/>
                </VBox>
            </placeholder>
        </TableView>
    </VBox>

    <!-- 2. Vue Tableau de bord de l'évaluation -->
    <VBox fx:id="dashboardView" spacing="12" VBox.vgrow="ALWAYS" maxHeight="Infinity" visible="false" managed="false">
        <!-- Barre de navigation supérieure et infos de l'épreuve active -->
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="view-header" style="-fx-padding: 4 0 8 0;">
            <Button fx:id="btnBackToEvalsList" text="← Liste des épreuves" onAction="#onBackToEvaluationsList" style="-fx-font-weight: bold;"/>
            <Separator orientation="VERTICAL"/>
            <Label fx:id="lblActiveEvalTitle" text="Tableau de bord de l'évaluation" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #181c20;"/>
            <Label fx:id="lblActiveEvalState" styleClass="tag-badge"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnOpenPdfFromDashboard" text="Voir le PDF généré" onAction="#onOpenGeneratedPdf"/>
        </HBox>

        <!-- Zone Glisser-Déposer pour les scans -->
        <VBox fx:id="dropZone" spacing="8" styleClass="drop-zone" style="-fx-padding: 12 16;">
            <HBox alignment="CENTER" spacing="8">
                <FontIcon iconLiteral="fth-upload-cloud" iconColor="#004faa" iconSize="20"/>
                <Label fx:id="lblDropZone" text="Glissez-déposez le fichier PDF des copies scannées ici" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #181c20;"/>
            </HBox>
            <Label text="Téléphone ou scanner à plat, ordre indifférent • Détection automatique par repères et codes PDF417" style="-fx-text-fill: #424753; -fx-font-size: 11px;"/>
            <HBox alignment="CENTER" spacing="12">
                <Button fx:id="btnBrowseFile" text="Parcourir un fichier..." onAction="#onBrowseFile"/>
                <Button fx:id="btnStartCorrection" text="Lancer la correction optique" disable="true" styleClass="btn-primary" onAction="#onStartCorrection"/>
            </HBox>
            <ProgressBar fx:id="progressBar" maxWidth="600" visible="false" progress="0.0"/>
            <Label fx:id="lblProgressStatus" text="" visible="false" style="-fx-font-size: 11px; -fx-text-fill: #424753;"/>
        </VBox>

        <!-- Cartes KPI Statistiques -->
        <HBox spacing="14">
            <VBox spacing="4" HBox.hgrow="ALWAYS" styleClass="kpi-card" style="-fx-padding: 10 14;">
                <Label text="TOTAL COPIES" styleClass="kpi-label"/>
                <Label fx:id="lblTotalCopies" text="0" styleClass="kpi-value" style="-fx-font-size: 20px;"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS" styleClass="kpi-card" style="-fx-padding: 10 14;">
                <Label text="TAUX DE RÉUSSITE" styleClass="kpi-label"/>
                <Label fx:id="lblSuccessRate" text="-" styleClass="kpi-value" style="-fx-font-size: 20px;"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS" styleClass="kpi-card" style="-fx-padding: 10 14;">
                <Label text="MOYENNE" styleClass="kpi-label"/>
                <Label fx:id="lblAverage" text="-" styleClass="kpi-value" style="-fx-font-size: 20px;"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS" styleClass="kpi-card" style="-fx-padding: 10 14;">
                <Label text="NOTE MIN / MAX" styleClass="kpi-label"/>
                <HBox spacing="6" alignment="BASELINE_LEFT">
                    <Label fx:id="lblMin" text="-" styleClass="kpi-value" style="-fx-font-size: 20px;"/>
                    <Label text="/" styleClass="kpi-label" style="-fx-font-size: 16px;"/>
                    <Label fx:id="lblMax" text="-" styleClass="kpi-value" style="-fx-font-size: 20px;"/>
                </HBox>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS" styleClass="kpi-card" style="-fx-padding: 10 14;">
                <Label text="MÉDIANE &amp; É-T" styleClass="kpi-label"/>
                <Label fx:id="lblMedianStd" text="-" styleClass="kpi-value" style="-fx-font-size: 18px;"/>
            </VBox>
        </HBox>

        <!-- Répartition visuelle des notes -->
        <HBox spacing="16" alignment="CENTER_LEFT" styleClass="card-box" style="-fx-padding: 8 16; -fx-background-color: -color-bg-subtle;">
            <Label text="Répartition :" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="0-5 :" style="-fx-font-size: 11px; -fx-text-fill: -color-fg-muted;"/>
                <Label fx:id="lblDist0to5" text="0" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #ba1a1a;"/>
            </HBox>
            <Separator orientation="VERTICAL"/>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="5-10 :" style="-fx-font-size: 11px; -fx-text-fill: -color-fg-muted;"/>
                <Label fx:id="lblDist5to10" text="0" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #b45309;"/>
            </HBox>
            <Separator orientation="VERTICAL"/>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="10-15 :" style="-fx-font-size: 11px; -fx-text-fill: -color-fg-muted;"/>
                <Label fx:id="lblDist10to15" text="0" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #004faa;"/>
            </HBox>
            <Separator orientation="VERTICAL"/>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="15-20 :" style="-fx-font-size: 11px; -fx-text-fill: -color-fg-muted;"/>
                <Label fx:id="lblDist15to20" text="0" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1b8744;"/>
            </HBox>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label text="Réussite :" style="-fx-font-size: 11px; -fx-text-fill: -color-fg-muted;"/>
            <ProgressBar fx:id="progressSuccessRate" prefWidth="120" progress="0.0"/>
        </HBox>

        <!-- Tableau de bord des notes & Exports (prend tout l'espace restant) -->
        <VBox spacing="8" VBox.vgrow="ALWAYS" maxHeight="Infinity">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Tableau de bord des notes" style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: -color-fg-default;"/>
                <TextField fx:id="txtSearchGrade" promptText="Filtrer par nom, matricule..." prefWidth="220" styleClass="search-field"/>
                <HBox spacing="4" alignment="CENTER_LEFT">
                    <Button fx:id="btnFilterAll" text="Tous" onAction="#onFilterAll" styleClass="card-action-btn"/>
                    <Button fx:id="btnFilterPassed" text="Admis (≥10)" onAction="#onFilterPassed" styleClass="card-action-btn"/>
                    <Button fx:id="btnFilterFailed" text="Ajournés (&lt;10)" onAction="#onFilterFailed" styleClass="card-action-btn"/>
                </HBox>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnViewStudentCopy" text="Voir Copie" disable="true" onAction="#onViewStudentCopy"/>
                <Button fx:id="btnExportExcel" text="Excel (.xlsx)" disable="true" onAction="#onExportExcel"/>
                <Button fx:id="btnExportPdfReport" text="PV Notes" disable="true" onAction="#onExportPdfReport"/>
                <Button fx:id="btnViewAnnotatedPdf" text="Toutes Copies" disable="true" onAction="#onViewAnnotatedPdf"/>
            </HBox>

            <TableView fx:id="gradesTable" VBox.vgrow="ALWAYS" maxHeight="Infinity" maxWidth="Infinity" minHeight="180" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colMatricule" text="Matricule" prefWidth="120" minWidth="100" maxWidth="160"/>
                    <TableColumn fx:id="colNom" text="Nom" prefWidth="180" minWidth="120"/>
                    <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="180" minWidth="120"/>
                    <TableColumn fx:id="colQuestions" text="Questions Corrigées" prefWidth="160" minWidth="130" maxWidth="200"/>
                    <TableColumn fx:id="colScore" text="Note Finale" prefWidth="120" minWidth="100" maxWidth="150"/>
                    <TableColumn fx:id="colAction" text="Copie Corrigée" prefWidth="150" minWidth="130" maxWidth="180"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <placeholder>
                    <VBox alignment="CENTER" spacing="10" styleClass="empty-state-box">
                        <FontIcon iconLiteral="fth-inbox" iconColor="#74777f" iconSize="36"/>
                        <Label text="Aucune note disponible" styleClass="empty-state-title" style="-fx-font-size: 14px;"/>
                        <Label text="Déposez le PDF scanné des copies ci-dessus pour lancer la correction automatique." styleClass="empty-state-subtitle"/>
                    </VBox>
                </placeholder>
            </TableView>
        </VBox>
    </VBox>
</VBox>
